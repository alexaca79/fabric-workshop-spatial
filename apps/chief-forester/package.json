{
  "name": "woodlands-chief-forester",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chief Forester dashboard for the Woodlands forest classification pipeline, built as a Fabric App on the Rayfin SDK",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "rayfin:dev": "npx rayfin dev",
    "rayfin:deploy": "npx rayfin up",
    "rayfin:deploy:dry": "npx rayfin up --dry-run",
    "rayfin:db": "npx rayfin up db apply",
    "rayfin:status": "npx rayfin up status"
  },
  "dependencies": {
    "@microsoft/rayfin-auth-provider-fabric": "^1.0.0",
    "@microsoft/rayfin-client": "^1.0.0",
    "@microsoft/rayfin-core": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
