# Copy to rayfin/.env and fill in. Never commit rayfin/.env.
#
# Values are interpolated into rayfin.yml with ${VAR} syntax and are also read
# by the Vite frontend at build time.

# Backend URL. Local dev default is http://localhost:5168.
# After `npx rayfin up` this becomes https://<your-app>-app.rayfin.windows.net
VITE_RAYFIN_API_URL=http://localhost:5168

# Publishable key for the client. Safe to ship in the frontend bundle, which is
# exactly why nothing sensitive may ever be placed here.
VITE_RAYFIN_PUBLISHABLE_KEY=pk-woodlands-chief-forester

# Written automatically by `npx rayfin up` into .env.fabric-<workspace>.
# Listed here so the required names are documented in one place.
# VITE_FABRIC_WORKSPACE_ID=
# VITE_FABRIC_ITEM_ID=
# VITE_FABRIC_PORTAL_URL=https://app.fabric.microsoft.com
