# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.python-version

# Jupyter
.ipynb_checkpoints/

# Build outputs that are regenerated by scripts/build_all.py
decks/assets/icons/*.png

# The built decks ARE committed, deliberately. They are the artefact a reviewer
# actually opens, and someone asked to comment on the content should not have to
# install Python and run a build to read a slide. Regenerate with
# `python scripts/build_all.py`; commit the result when the content changes.
!decks/out/*.pptx

# Local workshop review output; keep release decks and raw screenshot evidence.
decks/out/*-guide-preview.*
decks/out/manual-qa-*/
decks/out/qa-training-*.png
.copilot-tracking/

# Local scratch data - never commit imagery or customer inventory
data/
scratch/
*.tif
*.tiff
*.gpkg
*.parquet

# Live-environment scratch written by the Fabric deploy and debug scripts.
# These carry workspace ids, Livy session ids and run history from whichever
# capacity happened to be in use, which is machine state rather than material.
scripts/.*.json
scripts/.*.txt
scripts/.run-logs/

# OS / editor
.DS_Store
Thumbs.db
*.swp
