# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.python-version

# Jupyter
.ipynb_checkpoints/

# Build outputs that are regenerated by scripts/build_all.py
decks/out/*.pptx
decks/assets/icons/*.png

